# ===== Embedding / 向量库 =====
EMBEDDER=bge_m3                 # bge_m3 | hash（hash 仅开发兜底）
RERANKER=bge_reranker           # bge_reranker | none
VECTOR_STORE=milvus_lite        # milvus_lite | milvus | numpy
MILVUS_URI=./data/milvus_lite.db  # Standalone 时改为 http://localhost:19530
COLLECTION_NAME=lex_statutes

# ===== LLM（服务端演示模式用；BYOK 模式下这些保持为空） =====
LLM_BASE_URL=                   # OpenAI 兼容端点，例如 https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen2.5-7B-Instruct

# ===== 业务参数 =====
TOP_K=5
NLI_THRESHOLD=0.35
AUTO_INGEST=true                # 启动时若向量库为空则灌入种子数据
DATA_DIR=./data

# ===== 可选基础设施 =====
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexsentinel
