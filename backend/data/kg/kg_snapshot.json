  {
   "id": "SG-CASE-CHWEE-2005",
   "node_type": "precedent",
   "name": "Chwee Kin Keong v Digilandmall.com Pte Ltd",
   "aliases": [
    "电子合同",
    "标价错误",
    "Digilandmall",
    "单方错误"
   ],
   "props": {
    "citation": "[2005] SGCA 2; [2005] 1 SLR(R) 502",
    "court": "SGCA",
    "year": 2005,
    "holding": "网上打印机标价错误（S$66 vs 实价约 S$3,854），买家明知错误仍大量下单。上诉法院认定普通合同原则适用于电子交易，合同因单方错误（买家明知）无效。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-CASE-QUOINE-2020",
   "node_type": "precedent",
   "name": "Quoine Pte Ltd v B2C2 Ltd",
   "aliases": [
    "算法交易",
    "加密货币",
    "程序员",
    "Quoine",
    "B2C2"
   ],
   "props": {
    "citation": "[2020] SGCA(I) 2",
    "court": "SGCA(I)",
    "year": 2020,
    "holding": "确定性算法之间的交互可成立有约束力的合同；交易所单方撤销成交构成违约。单方错误分析中，编程时程序员的知悉可归属于运营方。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-CASE-SPANDECK-2007",
   "node_type": "precedent",
   "name": "Spandeck Engineering (S) Pte Ltd v Defence Science & Technology Agency",
   "aliases": [
    "Spandeck",
    "注意义务",
    "纯经济损失",
    "过失"
   ],
   "props": {
    "citation": "[2007] SGCA 37",
    "court": "SGCA",
    "year": 2007,
    "holding": "确立新加坡过失侵权注意义务的一般框架：事实可预见性、法律近邻性、政策因素三步检验。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-CASE-IADMIN-2020",
   "node_type": "precedent",
   "name": "I-Admin (Singapore) Pte Ltd v Hong Ying Ting",
   "aliases": [
    "保密",
    "商业秘密",
    "I-Admin",
    "离职员工"
   ],
   "props": {
    "citation": "[2020] SGCA 32; [2020] 1 SLR 1130",
    "court": "SGCA",
    "year": 2020,
    "holding": "修正违反保密义务的检验标准：信息具有保密性质且被不当获取/占有/使用的，即可构成违反保密义务，不再要求原告证明被告实际不当使用。",
    "jurisdiction": "SG"
   }
  },
  {
