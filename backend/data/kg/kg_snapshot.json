  {
   "id": "SG-PRIN-MISTAKE",
   "node_type": "principle",
   "name": "单方错误",
   "aliases": [
    "unilateral mistake",
    "错误",
    "mistake"
   ],
   "props": {
    "summary": "一方对合同基本条款（如价格）发生错误，且对方明知或应知该错误的，合同可因单方错误无效。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-PRIN-ECONTRACT",
   "node_type": "principle",
   "name": "电子合同成立",
   "aliases": [
    "electronic contract",
    "电子契约",
    "网络合同"
   ],
   "props": {
    "summary": "电子交易适用普通合同法原则；自动确认邮件不因由机器生成而当然无效。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-PRIN-DUTY-CARE",
   "node_type": "principle",
   "name": "注意义务（Spandeck 框架）",
   "aliases": [
    "duty of care",
    "Spandeck",
    "过失",
    "注意义务"
   ],
   "props": {
    "summary": "过失侵权注意义务三步检验：事实可预见性、法律近邻性、政策考量（Spandeck Engineering v DSTA [2007] SGCA 37 确立）。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-PRIN-CONFIDENCE",
   "node_type": "principle",
   "name": "违反保密义务",
   "aliases": [
    "breach of confidence",
    "保密",
    "商业秘密"
   ],
   "props": {
    "summary": "信息具有保密性质且被不当获取/使用的，即构成违反保密义务，无需证明实际损害使用（I-Admin v Hong Ying Ting [2020] SGCA 32 修正后的检验）。",
    "jurisdiction": "SG"
   }
  },
  {
   "id": "SG-PRIN-ALGO-CONTRACT",
   "node_type": "principle",
   "name": "算法交易的合同责任",
   "aliases": [
    "algorithm",
    "算法",
    "自动化交易",
    "程序员"
   ],
   "props": {
    "summary": "确定性算法之间可成立有约束力的合同；单方错误分析中，程序员的知悉可归属于运营算法的一方（Quoine v B2C2 [2020] SGCA(I) 2）。",
    "jurisdiction": "SG"
   }
  },
